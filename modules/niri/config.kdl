input {
    keyboard {
// @KEYBOARD@
        repeat-delay 600
        repeat-rate 25
        track-layout "global"
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
}
// @MONITORS@
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
prefer-no-csd
layout {
    gaps 8
    struts {
        left 0
        right 0
        top 0
        bottom -2
    }
    focus-ring { width 4; }
    border { off; }
    default-column-width
    center-focused-column "never"
    always-center-single-column
}
cursor {
    xcursor-theme "default"
    xcursor-size 12
    hide-when-typing
    hide-after-inactive-ms 2000
}
hotkey-overlay { skip-at-startup; }
binds {
    Mod+C { center-column; }
    Mod+Comma { consume-or-expel-window-left; }
    Mod+Ctrl+Down { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Down { focus-window-down; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+F { maximize-column; }
    Mod+Left { focus-column-left; }
    Mod+N { switch-preset-column-width; }
    Mod+O { toggle-overview; }
    Mod+Q { close-window; }
    Mod+Right { focus-column-right; }
    Mod+Semicolon { consume-or-expel-window-right; }
    Mod+Shift+Ctrl+Down { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-right; }
    Mod+Shift+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-left; }
    Mod+Shift+Down { focus-workspace-down; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { focus-column-left; }
    Mod+Tab { toggle-window-floating; }
    Mod+Up { focus-window-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
// @BINDS@
}
spawn-at-startup "xwayland-satellite"
window-rule { geometry-corner-radius 8.000000 8.000000 8.000000 8.000000; }
gestures { hot-corners { off; }; }
debug { honor-xdg-activation-with-invalid-serial; }
